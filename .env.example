# Optional one-off overrides; a fresh checkout runs without a .env.
# A value set here wins over the persistent config file (see docs/configuration.md).

# nanobot base config (default: skills/nanobot/nanobot-kernel-session/config.json)
# NANOBOT_CONFIG_BASE=

# repo paths to rsync, comma-separated (default: config/rsync_allowlist.json)
# RSYNC_ALLOWLIST=

# OpenAI-compatible endpoint: overrides the codex / cline config.json
# (OPENAI_BASE_URL works in place of OPENAI_API_BASE)
# OPENAI_API_KEY=
# OPENAI_API_BASE=

# claude-code (only to use something other than `claude login`)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# claude-code: parent of the per-job working directories, must be outside this
# repo (default: the system temp dir)
# ARMBENCH_CC_JOB_ROOT=

# own harness: persistent scratchpad tool (=1)
# ARMBENCH_NOTEPAD=

# own harness: litellm's key for any provider or field eval/llm_providers.json leaves out
# (the variable depends on the provider; ANTHROPIC_API_KEY above also applies)
# OPENROUTER_API_KEY=

# local bench/ harness: existing ncnn / llama.cpp checkouts
# NCNN_ROOT=
# LLAMA_CPP_ROOT=

# runs logged with --wandb: instance type label
# WANDB_INSTANCE_TYPE=

# provisioning: per-label SSH private key as JSON (default ~/.ssh/id_rsa for every label);
# Terraform imports the .pub next to it as that label's key pair
# TF_VAR_ssh_key_files='{"ncnn-sme2": "~/.ssh/mac-m4-key.pem"}'
